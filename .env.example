# ---------------------------------------------------------------------------
# CRO Audit AI — Environment Variables
# Copy to .env for local development (both apps load this file).
#
# Production split:
#   Vercel (apps/web)  → NEXT_PUBLIC_* only (+ NEXT_PUBLIC_API_URL)
#   Cloud Run (apps/api) → all server secrets below (never on Vercel)
# ---------------------------------------------------------------------------

# --- Frontend (Vercel / Next.js) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Local: API on :8080. Production: your Cloud Run URL (no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- Backend CORS (Cloud Run) ---
# Comma-separated browser origins allowed to call the API. Use * only for local
# experiments. Production example:
#   CORS_ORIGINS=https://your-app.vercel.app,https://www.your-domain.com
CORS_ORIGINS=http://localhost:3000

# --- Google PageSpeed Insights (Lighthouse metrics) ---
# Optional but recommended. Free key (25,000 req/day):
# https://console.cloud.google.com/apis/credentials (enable "PageSpeed Insights API")
GOOGLE_PAGESPEED_API_KEY=

# --- Screenshots (headless Chromium on the API) ---
# Local: point at an installed Chrome/Edge.
#   Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
#   macOS:   /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#   Linux:   /usr/bin/google-chrome
# Cloud Run Docker image sets CHROME_EXECUTABLE_PATH=/usr/bin/chromium automatically.
CHROME_EXECUTABLE_PATH=

# Cap simultaneous headless Chromium instances (Cloud Run concurrency should
# also stay low — typically 1–2).
MAX_CONCURRENT_BROWSERS=2

# --- Abuse controls (per-IP rate limiting, in-memory per instance) ---
RATE_LIMIT_ANALYZE_MAX=10
RATE_LIMIT_ANALYZE_WINDOW_MS=60000
RATE_LIMIT_MOCKUP_MAX=15
RATE_LIMIT_MOCKUP_WINDOW_MS=60000

# --- Result caching (opt-in, in-memory per API instance) ---
ENABLE_RESULT_CACHE=false
RESULT_CACHE_TTL_MS=600000
RESULT_CACHE_MAX_ENTRIES=20

# --- AI provider (API only) ---
# One of: mock | openai | anthropic | gemini
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview

# --- "After" concept mockups (Gemini image model, API /api/mockup) ---
ENABLE_FIX_MOCKUP=true
MOCKUP_MODEL=gemini-3-pro-image-preview
MOCKUP_IMAGE_SIZE=2K
MOCKUP_ASPECT_RATIO=16:9

# --- Shareable report links (Vercel Blob, apps/web only) ---
# Create a Blob store: Vercel dashboard → Storage → Blob. Connecting it to the
# web project injects BLOB_READ_WRITE_TOKEN automatically in production; for
# local dev, copy that token here. If unset, the Share button degrades to a
# clear "sharing isn't configured" message.
# BLOB_STORE_ID is added automatically when the store is connected (OIDC); the
# static BLOB_READ_WRITE_TOKEN is required by handleUpload for client uploads.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Daily cleanup cron (/api/cron/cleanup-reports) deletes shared reports older
# than 30 days (and trims oldest-first if the store nears the free 1 GB cap).
# Set CRON_SECRET to any long random string; Vercel sends it as a Bearer token
# on scheduled invocations, and the route rejects requests without it. Add the
# same value to the Vercel project env (Production) for the cron to authorize.
CRON_SECRET=

# --- Email verification (OTP) + report delivery (apps/web only) ---
# The report gate emails a 6-digit code that unlocks the full report, and can
# email the report link to the verified address. Delivery is over plain SMTP
# (nodemailer), so any mailbox works and NO domain/DNS is required. Requires
# Vercel Blob (BLOB_READ_WRITE_TOKEN above) to store the short-lived, hashed
# OTP records. If SMTP is unset, the gate still renders but shows a clear
# "email delivery is not configured" message.
#
# Gmail (no domain): SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
#   SMTP_USER=you@gmail.com, SMTP_PASS=<16-char App Password>.
#   App Passwords need 2-Step Verification: https://myaccount.google.com/apppasswords
#   From must be your Gmail address, so set EMAIL_FROM=CRO Audit <you@gmail.com>.
# Brevo (no domain, verify one sender): SMTP_HOST=smtp-relay.brevo.com,
#   SMTP_PORT=587, SMTP_USER=<brevo login>, SMTP_PASS=<SMTP key from Brevo >
#   SMTP & API>, EMAIL_FROM=<your verified sender>.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional; defaults to true only for port 465 (implicit TLS), false for 587.
# SMTP_SECURE=
# Display sender. Falls back to SMTP_USER when unset.
EMAIL_FROM=CRO Audit <you@gmail.com>
# Long random secret (>= 16 chars) used to HMAC the OTP codes + verification
# tokens. Generate one, e.g.: openssl rand -hex 32
OTP_SECRET=

# --- Branding (Vercel / Next.js) ---
NEXT_PUBLIC_BRAND_NAME=Your Agency
NEXT_PUBLIC_COMPANY=Your Agency LLC
NEXT_PUBLIC_LOGO_TEXT=CRO Audit by Your Agency
NEXT_PUBLIC_SITE_TITLE=CRO Audit by Your Agency
NEXT_PUBLIC_HERO_BADGE=Predictive CRO by Your Agency · 30% lift guaranteed in 90 days
NEXT_PUBLIC_FOOTER_DESCRIPTION=Predictive conversion rate optimization by Your Agency. Find out why your website isn't converting — and let our team fix it.

# --- Contact details (Vercel / Next.js) ---
NEXT_PUBLIC_BOOK_CALL_URL=https://cal.com/your-agency/strategy-call
NEXT_PUBLIC_CONTACT_URL=mailto:hello@your-agency.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@your-agency.com
NEXT_PUBLIC_PHONE=888.123.4567
NEXT_PUBLIC_ADDRESS_LINE1=123 Main St. Suite 100
NEXT_PUBLIC_ADDRESS_CITY=New York, NY 10001
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/company/your-agency

# ---------------------------------------------------------------------------
# CRO Audit AI - Environment Variables (Vercel-compatible, stateless)
# Copy this file to .env. Defaults work with no external services.
# ---------------------------------------------------------------------------

# --- Web app ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Google PageSpeed Insights (Lighthouse metrics) ---
# Optional but recommended. Free key (25,000 req/day):
# https://console.cloud.google.com/apis/credentials (enable "PageSpeed Insights API")
GOOGLE_PAGESPEED_API_KEY=

# --- Screenshots (self-hosted headless Chromium) ---
# Desktop full-page screenshots are captured in-process with puppeteer-core +
# @sparticuz/chromium (no external screenshot service). On Vercel this needs a
# plan with enough function memory/duration (see vercel.json).
# For LOCAL development, @sparticuz/chromium's Linux binary won't run, so point
# this at an installed Chrome/Edge executable:
#   Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
#   macOS:   /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#   Linux:   /usr/bin/google-chrome
CHROME_EXECUTABLE_PATH=

# --- AI provider ---
# One of: mock | openai | anthropic | gemini
#   mock      -> page-specific heuristic engine, no API keys, always works
#   openai    -> real vision LLM (needs OPENAI_API_KEY)
#   anthropic -> real vision LLM (needs ANTHROPIC_API_KEY)
#   gemini    -> real vision LLM (needs GEMINI_API_KEY)
# With openai/anthropic/gemini the model reads the page + screenshots and
# returns exclusive, page-specific findings; it falls back to mock on any error.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview

# --- "After" concept mockups (Google Nano Banana image model) ---
# When GEMINI_API_KEY is set, the report's Screenshots tab gets a "With fixes"
# toggle: an AI-generated concept of the page's above-the-fold hero with the
# audit's top conversion fixes applied. Independent of AI_PROVIDER (only needs
# the key). Set ENABLE_FIX_MOCKUP=false to turn this off.
#
# MOCKUP_MODEL picks the Nano Banana variant (higher = crisper text, slower):
#   gemini-3-pro-image-preview      -> Nano Banana Pro (default; best/legible text, 2K/4K)
#   gemini-3.1-flash-image-preview  -> Nano Banana 2   (faster, good text, 2K)
#   gemini-2.5-flash-image          -> Nano Banana     (legacy; blurrier text, 1K)
# MOCKUP_IMAGE_SIZE: 1K | 2K | 4K (2K recommended). MOCKUP_ASPECT_RATIO: a
# supported ratio like 16:9 or 4:3 — a single hero screenful keeps text large.
# The mockup is generated by its OWN endpoint (/api/mockup), called from the
# report page AFTER the audit renders — so Pro's ~40-60s never blocks the main
# audit and neither request risks the function time limit. Its budget is set by
# maxDuration in apps/web/vercel.json (bump it up to your Vercel plan's ceiling).
ENABLE_FIX_MOCKUP=true
MOCKUP_MODEL=gemini-3-pro-image-preview
MOCKUP_IMAGE_SIZE=2K
MOCKUP_ASPECT_RATIO=16:9

# --- Branding (change these to your own agency details) ---
NEXT_PUBLIC_BRAND_NAME=Your Agency
NEXT_PUBLIC_COMPANY=Your Agency LLC
NEXT_PUBLIC_LOGO_TEXT=CRO Audit by Your Agency
NEXT_PUBLIC_SITE_TITLE=CRO Audit by Your Agency
NEXT_PUBLIC_HERO_BADGE=Predictive CRO by Your Agency · 30% lift guaranteed in 90 days
NEXT_PUBLIC_FOOTER_DESCRIPTION=Predictive conversion rate optimization by Your Agency. Find out why your website isn't converting — and let our team fix it.

# --- Contact details ---
NEXT_PUBLIC_BOOK_CALL_URL=https://cal.com/your-agency/strategy-call
NEXT_PUBLIC_CONTACT_URL=mailto:hello@your-agency.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@your-agency.com
NEXT_PUBLIC_PHONE=888.123.4567
NEXT_PUBLIC_ADDRESS_LINE1=123 Main St. Suite 100
NEXT_PUBLIC_ADDRESS_CITY=New York, NY 10001
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/company/your-agency
